# User-owned runtime state. This includes the SQLite database, uploaded PDFs,
# annotations, conversations, derived assets, downloaded models, and backups.
data/

# Local credentials and environment overrides (keep the template tracked).
.env
.env.*
!.env.example
secrets/

# Python caches, test output, and local environments.
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Frontend dependencies, builds, and local deployment state.
frontend/node_modules/
frontend/.next/
frontend/.vinext/
frontend/dist/
frontend/out/
frontend/.wrangler/
frontend/.vercel/
frontend/coverage/

# Editor and operating-system metadata.
.DS_Store
.idea/
.vscode/
*.swp
